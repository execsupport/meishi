{
  "name": "meishi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build",
    "start": "wrangler dev -c wrangler.test.jsonc --port 8789",
    "db:local": "wrangler d1 migrations apply meishi --local -c wrangler.test.jsonc",
    "db:remote": "wrangler d1 migrations apply meishi --remote",
    "deploy": "npm run build && wrangler deploy",
    "test": "npm run build && playwright test",
    "test:prod": "playwright test -c playwright.prod.config.ts"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@playwright/test": "^1.48.0",
    "@preact/preset-vite": "^2.9.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
